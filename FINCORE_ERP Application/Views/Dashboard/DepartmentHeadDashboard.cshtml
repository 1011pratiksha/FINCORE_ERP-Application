@{
}
@{
    Layout = "_Layout";
    ViewData["Title"] = "Department Head Dashboard";
}

<div class="container-fluid py-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">🏢 Divisional Operations & Approval Controls</h1>
        <span class="badge bg-secondary p-2 fs-6">Cost Center Target Allocation</span>
    </div>

    <!-- Operational Controls Grid Layout -->
    <div class="row">
        <div class="col-lg-7">
            <div class="card shadow mb-4">
                <div class="card-header bg-danger text-white py-3"><h6 class="m-0 fw-bold">⚠️ High-Priority Verification Backlog</h6></div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div><strong>#PR-8021</strong> - Capital Equipment Procurement</div>
                            <span class="badge bg-warning text-dark">Awaiting Signature</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div><strong>#EX-9404</strong> - Local Travel Claim Reimbursements</div>
                            <span class="badge bg-warning text-dark">Awaiting Signature</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white py-3"><h6 class="m-0 fw-bold">Divisional Budgetary Usage</h6></div>
                <div class="card-body">
                    <h4 class="small font-weight-bold">Operational Account Pool <span class="float-end">72% Exhausted</span></h4>
                    <div class="progress mb-4" style="height: 15px;"><div class="progress-bar bg-warning" role="progressbar" style="width: 72%"></div></div>

                    <h4 class="small font-weight-bold">Capital Projects Reserve <span class="float-end">38% Exhausted</span></h4>
                    <div class="progress" style="height: 15px;"><div class="progress-bar bg-success" role="progressbar" style="width: 38%"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>
