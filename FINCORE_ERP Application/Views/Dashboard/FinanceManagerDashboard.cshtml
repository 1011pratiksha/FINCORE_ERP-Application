@{
}

@{
    Layout = "_Layout";
    ViewData["Title"] = "Finance Manager Dashboard";
}

<div class="container-fluid py-4">
    <h1 class="h3 mb-4 text-gray-800">📊 Corporate Finance Operations Panel</h1>

    <div class="row">
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-start border-primary border-4 shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Aggregated Pool Budgets</div>
                    <div class="fs-4 fw-bold">₹50,00,000 Total Allocation</div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-start border-warning border-4 shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Accounts Payable Outstanding</div>
                    <div class="fs-4 fw-bold text-warning">₹12,45,000 Pending</div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-start border-success border-4 shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-muted small text-uppercase">Accounts Receivable Queue</div>
                    <div class="fs-4 fw-bold text-success">₹18,90,000 Uncollected</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header bg-dark text-white py-3">
            <h6 class="m-0 font-weight-bold">Active Financial Accounting Hub</h6>
        </div>
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-3"><a href="/Dashboard/JournalEntryList" class="btn btn-outline-dark w-100 py-3 mb-2">📓 Journal Entries</a></div>
                <div class="col-md-3"><a href="/Dashboard/TrialBalance" class="btn btn-outline-dark w-100 py-3 mb-2">⚖️ Trial Balances</a></div>
                <div class="col-md-3"><a href="/Dashboard/BudgetVariance" class="btn btn-outline-dark w-100 py-3 mb-2">📉 Budget Variances</a></div>
                <div class="col-md-3"><a href="/Dashboard/PaymentHistory" class="btn btn-outline-dark w-100 py-3 mb-2">💸 Payment Records</a></div>
            </div>
        </div>
    </div>
</div>
