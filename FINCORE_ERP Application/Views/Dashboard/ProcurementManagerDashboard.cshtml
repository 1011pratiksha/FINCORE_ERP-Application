@{
}
@{
    Layout = "_Layout";
    ViewData["Title"] = "Procurement Dashboard";
}

<div class="container-fluid py-4">
    <h1 class="h3 mb-4 text-gray-800">📦 Logistics & Strategic Sourcing Portal</h1>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="bg-primary text-white card shadow h-100 p-3">
                <div class="small text-uppercase opacity-75">Unprocessed Purchase Requisitions</div>
                <div class="display-6 fw-bold">8 Open PRs</div>
                <a href="/Dashboard/PurchaseRequisitionList" class="text-white small mt-3 text-decoration-none">Review Requests →</a>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="bg-info text-white card shadow h-100 p-3">
                <div class="small text-uppercase opacity-75">Active Quotation Appraisals</div>
                <div class="display-6 fw-bold">12 RFQs</div>
                <a href="/Dashboard/RFQList" class="text-white small mt-3 text-decoration-none">Evaluate Vendor Responses →</a>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="bg-secondary text-white card shadow h-100 p-3">
                <div class="small text-uppercase opacity-75">Registered Supply Networks</div>
                <div class="display-6 fw-bold">45 Active Vendors</div>
                <a href="/Dashboard/VendorList" class="text-white small mt-3 text-decoration-none">Manage Contracts →</a>
            </div>
        </div>
    </div>

    <!-- Active Vendor Analysis Block Layout -->
    <div class="card shadow mb-4">
        <div class="card-header bg-light"><h6 class="m-0 font-weight-bold text-secondary">Procurement Pipelines & Document Control</h6></div>
        <div class="card-body">
            <p class="text-muted">Draft RFQs, analyze incoming matrix selections, complete formal Purchase Orders (POs), or review delivery documents.</p>
            <a href="/Dashboard/CreateRFQ" class="btn btn-sm btn-primary me-2">➕ Draft New RFQ</a>
            <a href="/Dashboard/PurchaseOrderList" class="btn btn-sm btn-outline-dark">📑 Track Active POs</a>
        </div>
    </div>
</div>
