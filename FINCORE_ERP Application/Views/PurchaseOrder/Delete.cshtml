@model PurchaseOrder


<h2>Delete Purchase Order</h2>

<h4>Are you sure you want to delete this Purchase Order?</h4>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Purchase Order ID
            </dt>
            <dd class="col-sm-9">
                @Model.PurchaseOrderId
            </dd>

            <dt class="col-sm-3">
                PO Number
            </dt>
            <dd class="col-sm-9">
                @Model.PONumber
            </dd>

            <dt class="col-sm-3">
                Vendor ID
            </dt>
            <dd class="col-sm-9">
                @Model.VendorId
            </dd>

            <dt class="col-sm-3">
                Quotation ID
            </dt>
            <dd class="col-sm-9">
                @Model.QuotationId
            </dd>

            <dt class="col-sm-3">
                Total Amount
            </dt>
            <dd class="col-sm-9">
                @Model.TotalAmount
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @Model.Status
            </dd>

        </dl>

        <form asp-action="DeleteConfirmed" method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.PurchaseOrderId" />

            <button type="submit" class="btn btn-danger">
                Delete
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>