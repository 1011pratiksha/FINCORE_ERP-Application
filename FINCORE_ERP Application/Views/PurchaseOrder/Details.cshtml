@model FINCORE_ERP_Application.Models.PurchaseOrder

@{
    ViewData["Title"] = "Purchase Order Details";
}

<h2>Purchase Order Details</h2>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Purchase Order ID
            </dt>
            <dd class="col-sm-9">
                @Model.PurchaseOrderId
            </dd>

            <dt class="col-sm-3">
                PO Number
            </dt>
            <dd class="col-sm-9">
                @Model.PONumber
            </dd>

            <dt class="col-sm-3">
                Vendor ID
            </dt>
            <dd class="col-sm-9">
                @Model.VendorId
            </dd>

            <dt class="col-sm-3">
                Quotation ID
            </dt>
            <dd class="col-sm-9">
                @Model.QuotationId
            </dd>

            <dt class="col-sm-3">
                Total Amount
            </dt>
            <dd class="col-sm-9">
                @Model.TotalAmount
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @Model.Status
            </dd>

            <dt class="col-sm-3">
                Active
            </dt>
            <dd class="col-sm-9">
                @Model.IsActive
            </dd>

            <dt class="col-sm-3">
                Created By
            </dt>
            <dd class="col-sm-9">
                @Model.CreatedBy
            </dd>

            <dt class="col-sm-3">
                Created At
            </dt>
            <dd class="col-sm-9">
                @Model.CreatedAt
            </dd>

            <dt class="col-sm-3">
                Modified By
            </dt>
            <dd class="col-sm-9">
                @Model.ModifiedBy
            </dd>

            <dt class="col-sm-3">
                Modified At
            </dt>
            <dd class="col-sm-9">
                @Model.ModifiedAt
            </dd>

        </dl>

        <a asp-action="Edit"
           asp-route-id="@Model.PurchaseOrderId"
           class="btn btn-warning">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>
</div>