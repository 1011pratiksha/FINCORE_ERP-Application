@model List<FINCORE_ERP_Application.Models.Vendor>

<h2>Vendor List</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add Vendor</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Vendor Code</th>
            <th>Category</th>
            <th>PAN</th>
            <th>Bank Account</th>
            <th>Performance</th>
            <th>Verified</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.VendorCode</td>
                <td>@item.VendorCategory?.CategoryName</td>
                <td>@item.PAN</td>
                <td>@item.BankAccount</td>
                <td>@item.PerformanceScore</td>
                <td>@item.IsVerified</td>
                <td>@item.IsActive</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.VendorId"
                       class="btn btn-info btn-sm">Details</a>

                    <a asp-action="Edit"
                       asp-route-id="@item.VendorId"
                       class="btn btn-warning btn-sm">Edit</a>

                    <a asp-action="Delete"
                       asp-route-id="@item.VendorId"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>