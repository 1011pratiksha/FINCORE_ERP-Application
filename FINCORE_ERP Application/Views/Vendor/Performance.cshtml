@model FINCORE_ERP_Application.Models.Vendor

<h2>Vendor Performance</h2>

<form asp-action="Performance" method="post">

    <input type="hidden" name="id" value="@Model.VendorId" />

    <div class="mb-3">
        <label>Vendor Code</label>
        <input value="@Model.VendorCode"
               class="form-control"
               readonly />
    </div>

    <div class="mb-3">
        <label>Performance Score</label>

        <input type="number"
               name="performanceScore"
               value="@Model.PerformanceScore"
               class="form-control"
               step="0.01"
               min="0"
               max="100" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</form>